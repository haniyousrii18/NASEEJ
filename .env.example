# =============================================================================
# Naseej | نَسيج — Environment Configuration
# =============================================================================

PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=naseej_dev
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Test Database Configuration
TEST_DB_NAME=naseej_dev

# Authentication & Security
JWT_SECRET=naseej_academic_prototype_jwt_secret_key_2026_secure
JWT_EXPIRES_IN=24h

# Protected File Storage (Outside public web root)
STORAGE_DIR=./storage/protected

# -----------------------------------------------------------------------------
# Optional: AI document analysis (OCR, classification, candidate extraction)
# OFF by default. Leave AI_PROVIDER empty and Naseej offers upload plus manual clinician review only.
# To turn it on: AI_PROVIDER=anthropic and a real ANTHROPIC_API_KEY from console.anthropic.com. Never commit the key.
# DATA HANDLING: when on, a document is sent to api.anthropic.com for analysis, and only if the patient allowed it for
# that file (or a clinician of the owning center starts it for a clinician-uploaded file). Use synthetic data only
# unless your own data-protection policy permits an external processor. Output is stored as UNREVIEWED suggestions.
# -----------------------------------------------------------------------------
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=120000
