# =============================================================================
# Naseej | نَسيج — Environment Configuration
# =============================================================================

PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=naseej_dev
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Test Database Configuration
TEST_DB_NAME=naseej_dev

# Authentication & Security
JWT_SECRET=naseej_academic_prototype_jwt_secret_key_2026_secure
JWT_EXPIRES_IN=24h
# Lifetime of a sign-in kept on the device ("keep me signed in")
JWT_REMEMBER_EXPIRES_IN=30d

# Protected File Storage (Outside public web root)
STORAGE_DIR=./storage/protected

# -----------------------------------------------------------------------------
# Optional: AI (document reading into suggestions the patient confirms, and the patient assistant)
# OFF by default. Leave AI_PROVIDER empty and Naseej says the AI is not connected; everything else still works.
# Choose ONE provider and set its key. Never commit a key.
#   AI_PROVIDER=gemini     key: GEMINI_API_KEY from aistudio.google.com (has a free tier)
#   AI_PROVIDER=anthropic  key: ANTHROPIC_API_KEY from console.anthropic.com (paid credits)
# DATA HANDLING: when on, a document is sent to the chosen provider only after the patient allowed it for that file, and assistant questions send a
# short text summary of the record only after the patient switched the assistant on. Use synthetic data only unless your own data-protection
# policy permits an external processor. On Google's FREE tier, content may be used to improve Google's products and seen by human reviewers.
# Readings are stored as UNCONFIRMED suggestions until the patient confirms them.
# -----------------------------------------------------------------------------
AI_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Leave empty to use the provider's default model (Gemini: the gemini-flash-latest alias, and if Google does not serve it the newest Flash model it lists; Anthropic: claude-sonnet-5-5).
AI_MODEL=
AI_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# Patient assistant (text and voice), visit-summary wording and temporary QR shares
# The assistant uses the SAME AI_PROVIDER / key / AI_MODEL as document reading above. With AI_PROVIDER empty the assistant
# says it is not connected and the app offers plain record search instead. Nothing is simulated.
# DATA HANDLING: a patient must switch the assistant on in the app. Then a short text summary of their record (titles,
# dates, short notes; no name, national ID or contact details) is sent to the provider with each question.
# -----------------------------------------------------------------------------
# Time limit for one assistant reply, in milliseconds.
AI_CHAT_TIMEOUT_MS=25000
# Assistant messages one patient may send per hour.
ASSISTANT_MAX_PER_HOUR=40
# Longest lifetime of a QR share, in hours (168 = 7 days).
SHARE_MAX_HOURS=168
# Reverse proxies in front of the API (0 = none). Set to 1 behind one proxy/load balancer so rate limits use the client address.
TRUST_PROXY=0

# Email for sign-up confirmation and password reset (see docs/features/accounts.md).
# Leave SMTP_HOST empty in development: nothing is sent, and each message (with its link) is printed in the API console.
# In production an empty SMTP_HOST makes sign-up and password reset answer "email is not configured" instead of pretending.
SMTP_HOST=
SMTP_PORT=587
# true = TLS from the start (usually port 465); false = STARTTLS (usually port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Naseej <no-reply@your-domain.example>"
# The address of the website, used for the links in those emails.
APP_URL=http://localhost:3000

# Automatic Arabic/English translation of text people type. NOT done by AI and not by the assistant.
# local = built-in medical glossary + a local machine-translation model (run `npm run translate:models` once in backend/).
# Empty = off: typed text is shown as written with a note that no translation is available.
# Set TRANSLATION_MT=off to use only the glossary.
TRANSLATION_PROVIDER=local
