# =============================================================================
# Naseej | نَسيج — Environment Configuration
# =============================================================================

PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=naseej_dev
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Test Database Configuration
TEST_DB_NAME=naseej_dev

# Authentication & Security
JWT_SECRET=naseej_academic_prototype_jwt_secret_key_2026_secure
JWT_EXPIRES_IN=24h

# Protected File Storage (Outside public web root)
STORAGE_DIR=./storage/protected

# -----------------------------------------------------------------------------
# Optional: AI document analysis (OCR, classification, candidate extraction)
# OFF by default. Leave AI_PROVIDER empty and Naseej offers upload plus manual clinician review only.
# Choose ONE provider and set its key. Never commit a key.
#   AI_PROVIDER=gemini     key: GEMINI_API_KEY from aistudio.google.com (has a free tier)
#   AI_PROVIDER=anthropic  key: ANTHROPIC_API_KEY from console.anthropic.com (paid credits)
# DATA HANDLING: when on, a document is sent to the chosen provider's API (Google or Anthropic), and only if the patient allowed it for
# that file (or a clinician of the owning center starts it for a clinician-uploaded file). Use synthetic data only
# unless your own data-protection policy permits an external processor. On Google's FREE tier, content may be used to
# improve Google's products and seen by human reviewers: synthetic documents only. Output is stored as UNREVIEWED suggestions.
# -----------------------------------------------------------------------------
AI_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Leave empty to use the provider's default model (Gemini: the gemini-flash-latest alias, and if Google does not serve it the newest Flash model it lists; Anthropic: claude-sonnet-5-5).
AI_MODEL=
AI_TIMEOUT_MS=120000
